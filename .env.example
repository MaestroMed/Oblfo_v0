# Domaine canonique (obflo.com en prod ; obflo.fr = redirection 301 côté DNS/Vercel)
NEXT_PUBLIC_SITE_URL=https://obflo.com

# Stripe — le checkout renvoie 503 "payment_not_configured" tant que la clé est absente
STRIPE_SECRET_KEY=
# Secret de signature du webhook /api/webhooks/stripe (dashboard Stripe > Webhooks)
STRIPE_WEBHOOK_SECRET=

# Webhook d'inscription newsletter (Brevo/Make/app de pilotage). Absent = le
# formulaire affiche "ouverture bientôt" au lieu d'une fausse confirmation.
NEWSLETTER_WEBHOOK_URL=

# Transmission des commandes payées (app de pilotage / automatisation CJ).
# Chaque checkout.session.completed est POSTé ici en JSON normalisé
# (header x-idempotency-key = id de session Stripe — dédupliquer dessus).
# En cas d'échec, le webhook répond 500 et Stripe réessaie ~3 jours.
# Absent = trace [obflo:order] dans les logs Vercel uniquement.
ORDERS_WEBHOOK_URL=
